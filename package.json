{
  "name": "duet",
  "productName": "Duet",
  "version": "2.0.0",
  "description": "Claude Code and Codex in one sleek desktop app. Switch agents mid-thread, manage MCP, sync and back up everything.",
  "author": "N00BN00BN00B",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "DUET_LIVE=1 vitest run tests/live",
    "test:e2e": "npm run build && playwright test",
    "icons": "node scripts/build-icons.mjs",
    "dist": "npm run build && node scripts/dist.mjs",
    "dist:dir": "npm run build && node scripts/dist.mjs --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "smol-toml": "^1.9.0",
    "tailwindcss": "^4.3.3",
    "tar-stream": "^3.2.2",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true,
    "electron-winstaller": false
  }
}
